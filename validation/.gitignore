# Outputs from the two Fortran validation runs.
run/*/*.dat
run/*/*.log
run/*/restart
run/*/restart.*
# Python caches; retain only the input files and checked-in references.
__pycache__/
*.pyc
.DS_Store

# Explicitly track ONLY the three small fixture input files, even when the
# repository-level .gitignore excludes all PSF/PDB/DCD production data.
!input/wildtype.psf
!input/wildtype.pdb
!input/wildtype.dcd
